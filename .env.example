# ---- Database (Neon serverless Postgres) ----
# MUST include sslmode=require (enforced at startup by src/config/env.ts)
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ---- Better Auth ----
# Generate: openssl rand -base64 32   (min 32 chars; never commit the real value)
BETTER_AUTH_SECRET=
# Public origin of this app (https in production)
BETTER_AUTH_URL=http://localhost:3000
# ---- Security ----
# Comma-separated allowed browser origins (CSRF/origin allowlist)
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
# ---- SPII column encryption (Metro-2 export enclave; KMS-injected in prod) ----
# >= 32 chars. In production this comes from AWS/GCP KMS with 90-day rotation.
SPII_MASTER_KEY=
SPII_KEY_ID=k1
# ---- Web portal (Next.js) ----
# Base URL of the Hono gateway the portal calls with credentialed fetch.
NEXT_PUBLIC_API_BASE=http://localhost:3000
# ---- Phase-5 hardening ----
# Audit-chain integrity monitor interval (ms); default 1h in production.
AUDIT_MONITOR_INTERVAL_MS=
