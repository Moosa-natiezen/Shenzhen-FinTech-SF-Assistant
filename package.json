{
  "name": "sz-fintech-sf-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx src/server/dev.ts",
    "start": "tsx src/server/index.ts",
    "dev:web": "next dev",
    "build:web": "next build",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck:web": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@hono/node-server": "^2.1.4",
    "@neondatabase/serverless": "^1.2.0",
    "@types/node": "^26.6.5",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
